DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_parking
DB_USER=root
DB_PASSWORD=

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
PORT=5000
CLIENT_URL=http://localhost:4173
NODE_ENV=development

# Reservation expiry grace period, in minutes
BOOKING_GRACE_PERIOD_MINUTES=15

# Fee calculation rule: "rounded" charges full hours rounded up, "exact" charges to the minute
FEE_ROUNDING_MODE=rounded
